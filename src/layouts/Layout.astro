---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Suzuki Parts Expert | Repuestos Genuinos y Compatibilidad Garantizada",
	description = "Catálogo técnico interactivo, decodificador VIN, despieces exploded-view y asistente de mantenimiento de motocicletas Suzuki."
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#f7f9fb] text-[#191c1e] font-sans antialiased">
		<slot />
	</body>
</html>
