# URL pública del sitio (usada por Astro y enlaces absolutos)
PUBLIC_SITE_URL=https://suzukirepuestoscolombia.miecommerce.shop

# Mostrar imágenes en las cards del catálogo (true | false)
PUBLIC_SHOW_PRODUCT_IMAGES=false

# Zona horaria por defecto de la tienda (ej. America/Bogota)
DEFAULT_TIMEZONE=America/Bogota
PUBLIC_DEFAULT_TIMEZONE=America/Bogota

# Clave de API de Google Gemini para el Asistente IA Técnico Suzuki
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Base de datos Neon PostgreSQL
DATABASE_URL=postgresql://usuario:password@host.neon.tech/db?sslmode=require

# Base REST de Neon para URLs de imágenes
NEON_REST_API_URL=https://tu-proyecto.apirest.us-east-2.aws.neon.tech/neondb/rest/v1

# Secret HS256 para tokens JWT
JWT_SECRET=tu_secret_jwt_aqui

# Almacenamiento compatible con S3 (imágenes)
AWS_ENDPOINT_URL_S3=https://tu-endpoint.s3.neon.tech
AWS_ACCESS_KEY_ID=tu_access_key
AWS_SECRET_ACCESS_KEY=tu_secret_key
AWS_REGION=us-east-2
AWS_S3_BUCKET_NAME=moto-parts-bucket